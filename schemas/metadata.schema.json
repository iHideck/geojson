{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iHideck/geojson/blob/main/schemas/metadata.schema.json",
  "title": "レイヤーの metadata.json",
  "description": "出典・取得日・ライセンス・クレジット・加工の内容・解像度・ファイルの大きさを記録する。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "geometry", "crs", "license", "credit", "disclaimer", "sources", "processing", "attributes", "resolutions"],
  "$defs": {
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ja", "en"],
      "properties": {
        "ja": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    },
    "license": { "enum": ["PDM-1.0", "CC0-1.0", "CC-BY-4.0", "PDL-1.0", "JP-COPYRIGHT-ACT-13"] }
  },
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z-]*/[a-z][a-z-]*$" },
    "title": { "$ref": "#/$defs/text" },
    "geometry": { "enum": ["polygon", "line", "point"] },
    "crs": { "const": "EPSG:4326" },
    "license": { "$ref": "#/$defs/license" },
    "credit": { "$ref": "#/$defs/text" },
    "disclaimer": { "$ref": "#/$defs/text" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "publisher", "version", "retrieved", "urls", "page_url", "license", "license_url"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "publisher": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "retrieved": { "type": ["string", "null"], "format": "date" },
          "urls": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uri" } },
          "page_url": { "type": "string", "format": "uri" },
          "license": { "$ref": "#/$defs/license" },
          "license_url": { "type": "string", "format": "uri" }
        }
      }
    },
    "processing": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "attributes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "nullable", "description"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,9}$" },
          "type": { "enum": ["string", "number"] },
          "nullable": { "type": "boolean" },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "resolutions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "precision", "features", "vertices", "files"],
        "properties": {
          "id": { "enum": ["50m", "110m", "medium", "low"] },
          "precision": { "type": "integer", "minimum": 4, "maximum": 5 },
          "features": { "type": "integer", "minimum": 1 },
          "vertices": { "type": "integer", "minimum": 1 },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["format", "name", "bytes", "url"],
              "properties": {
                "format": { "enum": ["geojson", "topojson", "shp", "fgb", "parquet", "pmtiles"] },
                "name": { "type": "string", "minLength": 1, "description": "GitHub Release のファイル名" },
                "bytes": { "type": "integer", "minimum": 1 },
                "url": { "type": "string", "format": "uri", "description": "GitHub Release の最新版の URL" },
                "pages_url": {
                  "type": "string",
                  "format": "uri",
                  "description": "GitHub Pages の URL。ブラウザから CORS と Range 要求で読める形式だけにある"
                }
              }
            }
          }
        }
      }
    }
  }
}
