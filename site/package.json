{
  "name": "geojson-viewer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "node --test src/*.test.ts",
    "preview": "vite preview",
    "capture": "node scripts/capture.ts",
    "test:e2e": "playwright test",
    "budget": "node scripts/budget.ts",
    "lighthouse": "lhci autorun --config=lighthouserc.desktop.json && lhci autorun --config=lighthouserc.mobile.json"
  },
  "dependencies": {
    "maplibre-gl": "6.16.0",
    "pmtiles": "4.5.0"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@types/geojson": "7946.0.16",
    "@types/node": "24.19.2",
    "sirv": "3.0.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
