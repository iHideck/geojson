{
  "ci": {
    "collect": {
      "startServerCommand": "npx vite preview --port 4175 --strictPort",
      "startServerReadyPattern": "localhost:4175",
      "url": [
        "http://localhost:4175/geojson/#map=4.85/36.4/138.2"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --use-angle=swiftshader --enable-unsafe-swiftshader --disable-gpu-compositing",
        "onlyCategories": [
          "performance",
          "accessibility",
          "best-practices",
          "seo"
        ],
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500,
            "aggregationMethod": "median"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "../.lighthouseci/desktop"
    }
  }
}
